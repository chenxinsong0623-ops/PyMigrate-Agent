# 当前本地配置。将此文件复制为 .env 即可覆盖默认值。
# MigrationLens Day 2 仅实现 SQLite 最小基础设施。
# 当前不配置 API Key、真实模型、Embedding 或 Qdrant；后续变量只在对应功能实现后加入。

MIGRATIONLENS_ENVIRONMENT=development
MIGRATIONLENS_LOG_LEVEL=INFO
MIGRATIONLENS_LLM_BACKEND=fake
MIGRATIONLENS_SQLITE_PATH=var/data/migrationlens.sqlite3
MIGRATIONLENS_SQLITE_TIMEOUT_SECONDS=2
