# 当前本地配置。将此文件复制为 .env 即可覆盖默认值。
# Day 7 已将 SQLite 与 Qdrant 接入应用 lifespan 和 readiness。
# 文档索引只由显式 Day 10 builder 构建；新环境在构建前仍会诚实返回 503。

MIGRATIONLENS_ENVIRONMENT=development
MIGRATIONLENS_LOG_LEVEL=INFO
MIGRATIONLENS_LLM_BACKEND=fake
# 仅当 backend=openai_compatible 时填写以下三项；不要提交真实 API key。
# MIGRATIONLENS_LLM_BASE_URL=https://provider.example/v1
# MIGRATIONLENS_LLM_MODEL=provider-model-id
# MIGRATIONLENS_LLM_API_KEY=replace-with-secret-from-runtime-environment
MIGRATIONLENS_LLM_MAX_OUTPUT_TOKENS=2048
MIGRATIONLENS_SQLITE_PATH=var/data/migrationlens.sqlite3
MIGRATIONLENS_SQLITE_TIMEOUT_SECONDS=2
MIGRATIONLENS_READINESS_TIMEOUT_SECONDS=1
# 主机直接运行 API 时使用 localhost；Compose 会覆盖为 http://qdrant:6333。
# URL 配置成功不代表 Qdrant 服务实际可用，应用 startup 会验证真实服务与 collection。
MIGRATIONLENS_QDRANT_URL=http://127.0.0.1:6333
MIGRATIONLENS_QDRANT_COLLECTION_NAME=migrationlens-documents
MIGRATIONLENS_QDRANT_TIMEOUT_SECONDS=2
# 真实模型只在显式 dense index/query 命令中加载；普通 pytest 和 API startup 不下载。
MIGRATIONLENS_EMBEDDING_CACHE_PATH=var/cache/huggingface
MIGRATIONLENS_EMBEDDING_BATCH_SIZE=16
MIGRATIONLENS_EMBEDDING_TIMEOUT_SECONDS=120
# Day 11 RRF 的 rank smoothing 常量；正整数 1..1000，默认 60。
MIGRATIONLENS_RRF_K=60
