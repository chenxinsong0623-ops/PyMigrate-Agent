# 当前本地配置。将此文件复制为 .env 即可覆盖默认值。
# MigrationLens Day 4 已实现 SQLite 与 readiness 聚合边界。
# 当前没有 retriever backend、Embedding 或 Qdrant；默认 readiness 会诚实返回 503。

MIGRATIONLENS_ENVIRONMENT=development
MIGRATIONLENS_LOG_LEVEL=INFO
MIGRATIONLENS_LLM_BACKEND=fake
MIGRATIONLENS_SQLITE_PATH=var/data/migrationlens.sqlite3
MIGRATIONLENS_SQLITE_TIMEOUT_SECONDS=2
MIGRATIONLENS_READINESS_TIMEOUT_SECONDS=1
# Day 6 仅提供 Qdrant 生命周期边界；尚未接入 FastAPI，也未实现检索或写入。
MIGRATIONLENS_QDRANT_URL=http://127.0.0.1:6333
MIGRATIONLENS_QDRANT_COLLECTION_NAME=migrationlens-documents
MIGRATIONLENS_QDRANT_TIMEOUT_SECONDS=2
